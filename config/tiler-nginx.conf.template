# Reverse proxy in front of TiTiler: shared tile cache + long browser Cache-Control.
# Tile URLs already encode COG path, TMS, colormap, and rescale, so responses are
# immutable for a given URI.
#
# Rendered by the nginx image entrypoint (envsubst) from this template into
# /etc/nginx/conf.d/default.conf. Cache sizing/TTL knobs come from the env file
# (see TILER_CACHE_* in .env.template) - do not hardcode them here.
#
# Upstream hostname ``titiler`` is the Compose service name (Docker DNS SSOT).
# ``resolve`` re-queries 127.0.0.11 so a titiler recreate does not leave a
# stale IP and 502 until this proxy is also recreated.

proxy_cache_path /var/cache/nginx/tiles
    levels=1:2
    keys_zone=tiler_tiles:${TILER_CACHE_KEYS_ZONE_SIZE}
    max_size=${TILER_CACHE_MAX_SIZE}
    inactive=${TILER_CACHE_INACTIVE}
    use_temp_path=off;

upstream titiler_upstream {
    zone titiler 64k;
    resolver 127.0.0.11 valid=10s ipv6=off;
    server titiler:80 resolve;
    keepalive 32;
}

server {
    listen 80;
    server_tokens off;

    # Low-latency delivery & file descriptor caching for cached tile slices
    tcp_nodelay on;
    open_file_cache max=10000 inactive=60m;
    open_file_cache_valid 120s;
    open_file_cache_min_uses 1;
    open_file_cache_errors on;

    # Large tile query strings (asset keys + style params).
    client_max_body_size 0;

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://titiler_upstream;
    }

    # titiler-pgstac Item tiles.
    location ~* /collections/.+/items/.+/tiles/ {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_pass http://titiler_upstream;

        proxy_cache tiler_tiles;
        proxy_cache_key $request_uri;
        proxy_cache_methods GET HEAD;
        proxy_cache_valid 200 ${TILER_CACHE_VALID};
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_lock on;
        proxy_cache_lock_timeout 5s;
        proxy_cache_lock_age 5s;
        proxy_ignore_headers Cache-Control Set-Cookie Vary;
        # Drop TiTiler's short max-age / CORS so we emit a single set of headers.
        proxy_hide_header Cache-Control;
        proxy_hide_header Access-Control-Allow-Origin;
        proxy_hide_header Access-Control-Allow-Methods;
        proxy_hide_header Access-Control-Allow-Headers;
        add_header X-Cache-Status $upstream_cache_status always;

        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Origin, Content-Type, Accept' always;
        add_header Cache-Control "public, max-age=3600, immutable" always;
    }
}
