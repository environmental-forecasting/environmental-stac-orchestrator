# ------------------------------------------------------------------------------
# ENVIRONMENT: TEMPLATE
# Copy this file to .env.development, .env.staging, or .env.production
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# General config
# ------------------------------------------------------------------------------

# IP address of the host machine (used in local development for routing / ingest)
HOST_IP=127.0.0.1

# Domain name (required for staging/production Traefik routing)
DOMAIN_NAME=example.bas.ac.uk

# Let's Encrypt email (required for staging/production TLS)
ACME_EMAIL=admin@example.bas.ac.uk

# Let's Encrypt CA directory (use the staging CA in .env.staging to avoid rate limits)
# Production default is used when unset: https://acme-v02.api.letsencrypt.org/directory
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# Workers for backend services
WORKERS=12

# ------------------------------------------------------------------------------
# Compose isolation (one stack at a time; separate project + DB volume per env)
# ------------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME is documented here; Make passes --project-name explicitly.
COMPOSE_PROJECT_NAME=stac-dev
POSTGRES_VOLUME_NAME=environmental_pgstac_dev

# ------------------------------------------------------------------------------
# Ports (used in development via compose.override.yaml; unused behind Traefik)
# ------------------------------------------------------------------------------
STAC_FASTAPI_PORT=8000
FILE_SERVER_PORT=8001
TILER_PORT=8002
# Gunicorn workers for the TiTiler container (tile renders are CPU-bound).
TILER_WEB_CONCURRENCY=4
DATABASE_PORT=5432
DASHBOARD_PORT=8082
STAC_BROWSER_PORT=81

# ------------------------------------------------------------------------------
# Database config
# ------------------------------------------------------------------------------
DATABASE_USER=stac
DATABASE_PASSWORD=your_secure_password_here
DATABASE_DBNAME=postgis

# ------------------------------------------------------------------------------
# URL configurations
# ------------------------------------------------------------------------------
# Development: HTTP and ports, e.g. http://127.0.0.1:8001
# Staging/production: HTTPS and paths, e.g. https://${DOMAIN_NAME}/files
# Browser-facing only. Compose sets TILER_INTERNAL_URL / FILE_SERVER_INTERNAL_URL
# for container-to-container calls (http://titiler, http://file-server).
# Prefer same-origin tiles locally: http://localhost/tiles (dashboard proxies
# to tiler-cache). http://127.0.0.1:8002 with a page on http://localhost is
# cross-origin; Chrome ORB-blocks JSON bodies from failed tile requests.
FILE_SERVER_URL=http://127.0.0.1:8001
STAC_FASTAPI_URL=http://127.0.0.1:8000
TILER_URL=http://localhost/tiles

# ------------------------------------------------------------------------------
# Development features
# ------------------------------------------------------------------------------
# Enable hot reloading for the dashboard (true only in development)
DASHBOARD_DEBUG=false
