# ------------------------------------------------------------------------------
# ENVIRONMENT: TEMPLATE
# Copy this file to .env.development, .env.staging, or .env.production
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# General config
# ------------------------------------------------------------------------------

# IP/hostname for Traefik Host() match (with localhost/127.0.0.1/DOMAIN_NAME) and ingest routing
HOST_IP=127.0.0.1

# Domain name (required for staging/production Traefik routing)
DOMAIN_NAME=example.bas.ac.uk

# Let's Encrypt email (required for staging/production TLS)
ACME_EMAIL=admin@example.bas.ac.uk

# Let's Encrypt CA directory (use the staging CA in .env.staging to avoid rate limits)
# Production default is used when unset: https://acme-v02.api.letsencrypt.org/directory
# ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory

# ------------------------------------------------------------------------------
# Compose isolation (one stack at a time; separate project + DB volume per env)
# ------------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME is documented here; Make passes --project-name explicitly.
COMPOSE_PROJECT_NAME=stac-dev
POSTGRES_VOLUME_NAME=environmental_pgstac_dev

# ------------------------------------------------------------------------------
# Ports
# ------------------------------------------------------------------------------
# HTTP port for Traefik edge router (serves all path prefixes: /, /dashboard, /browser, /api, /files, /tiles)
TRAEFIK_HTTP_PORT=80
# Gunicorn workers for the TiTiler container (tile renders are CPU-bound).
TILER_WEB_CONCURRENCY=4
# Nginx tile-cache (tiler-cache service) - sizing/TTL SSOT for config/tiler-nginx.conf.template
TILER_CACHE_MAX_SIZE=5g
TILER_CACHE_INACTIVE=7d
TILER_CACHE_KEYS_ZONE_SIZE=64m
TILER_CACHE_VALID=7d
# Database port exposed on the host machine for CLI ingestion (e.g. envstacgen)
DATABASE_PORT=5432

# ------------------------------------------------------------------------------
# Database config
# ------------------------------------------------------------------------------
DATABASE_USER=stac
DATABASE_PASSWORD=your_secure_password_here
DATABASE_DBNAME=postgis

# ------------------------------------------------------------------------------
# URL configurations
# ------------------------------------------------------------------------------
# Development: http://localhost/files, http://localhost/tiles
# Staging/production: https://<DOMAIN_NAME>/files and /tiles - same path prefixes as
# Traefik in compose.yaml (routing SSOT). Expand DOMAIN_NAME when writing
# .env.staging / .env.production; do not leave literal ${DOMAIN_NAME} in values.
# Browser-facing only. STAC FastAPI for the dashboard is set in compose.yaml to
# Docker DNS (http://stac-fastapi:8000), not from this file. Public /api is Traefik.
FILE_SERVER_URL=http://localhost/files
TILER_URL=http://localhost/tiles

# ------------------------------------------------------------------------------
# Development features
# ------------------------------------------------------------------------------
# Enable hot reloading for the dashboard (true only in development)
DASHBOARD_DEBUG=false
