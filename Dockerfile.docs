# Build all three Zensical docs sites for Traefik PathPrefix(/docs).
# site_url is path-only so the same image works for any DOMAIN_NAME.
# --only-group docs skips project runtime deps (generator is a full package).

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build-orchestrator
WORKDIR /build
COPY pyproject.toml uv.lock zensical.toml ./
COPY docs ./docs
RUN sed -i 's|^#* *site_url = .*|site_url = "/docs/orchestrator/"|' zensical.toml \
    && uv sync --only-group docs --no-install-project \
    && uv run --only-group docs zensical build --clean

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build-dashboard
WORKDIR /build
COPY environmental-stac-dashboard/pyproject.toml \
     environmental-stac-dashboard/uv.lock \
     environmental-stac-dashboard/zensical.toml ./
COPY environmental-stac-dashboard/docs ./docs
RUN sed -i 's|^#* *site_url = .*|site_url = "/docs/dashboard/"|' zensical.toml \
    && uv sync --only-group docs --no-install-project \
    && uv run --only-group docs zensical build --clean

FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim AS build-generator
WORKDIR /build
COPY environmental-stac-generator/pyproject.toml \
     environmental-stac-generator/uv.lock \
     environmental-stac-generator/zensical.toml ./
COPY environmental-stac-generator/docs ./docs
RUN sed -i 's|^#* *site_url = .*|site_url = "/docs/generator/"|' zensical.toml \
    && uv sync --only-group docs --no-install-project \
    && uv run --only-group docs zensical build --clean

FROM nginx:1.31.3
COPY config/docs/nginx.conf /etc/nginx/conf.d/default.conf
COPY config/docs/index.html /usr/share/nginx/html/docs/index.html
COPY --from=build-orchestrator /build/site /usr/share/nginx/html/docs/orchestrator
COPY --from=build-dashboard /build/site /usr/share/nginx/html/docs/dashboard
COPY --from=build-generator /build/site /usr/share/nginx/html/docs/generator
